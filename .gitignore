# ==========================================
# Spring Boot & Java (Backend)
# ==========================================
# Compiled class files
*.class

# Log files
*.log
HelloWorld/log/

# Package Files (Must ignore these to keep repo light)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# EXCEPTIONS: Keep the Maven wrapper so others can build your project
!HelloWorld/.mvn/wrapper/maven-wrapper.jar

# Build folders
HelloWorld/target/
target/
!**/src/main/**/target/
!**/src/test/**/target/

# ==========================================
# React / Node.js (Frontend)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Production build folders
build/
dist/

# Local environment variables (IMPORTANT: Never push secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# Zoho Catalyst & Deployment
# ==========================================
# Explicitly ensuring no jars from the deployment folder get uploaded
Deployment/*.jar
.catalyst/

